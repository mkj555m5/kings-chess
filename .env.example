# انسخ هذا الملف إلى .env وعبّئ القيم

# قاعدة البيانات (Prisma + SQLite) للتطوير و Railway
DATABASE_URL=file:./db/custom.db

# Ollama API - نموذج gemma4 (إلزامي للعب ضد الوزير وتعليقاته)
# احصل على مفتاحك من https://ollama.com
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
AI_MODEL=gemma4

# ===== بوت تلجرام (اختياري — يعمل على Railway/Node فقط) =====
# 1) أنشئ بوتاً من @BotFather وانسخ الرمز هنا
TELEGRAM_BOT_TOKEN=
# 2) معرّف المالك الرقمي (من @userinfobot أو أمر /myid في البوت)
# يمكن وضع عدة معرفات مفصولة بفواصل
TELEGRAM_OWNER_ID=
# 3) رابط الموقع العام (على Railway يُكتشف تلقائياً من RAILWAY_PUBLIC_DOMAIN)
# SITE_URL=https://your-app.up.railway.app
# 4) للتشغيل المحلي بدون رابط عام: فعّل Polling بدلاً من Webhook
# TELEGRAM_POLLING=1

# ===== Cloudflare (يضبطها wrangler.jsonc تلقائياً عند النشر - لا حاجة لتعديلها هنا) =====
# CF_DEPLOY=1
# REALTIME_URL=/rt
