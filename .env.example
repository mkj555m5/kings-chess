# انسخ هذا الملف إلى .env وعبّئ القيم

# قاعدة البيانات (Prisma + SQLite)
DATABASE_URL=file:./db/custom.db

# Ollama API - نموذج gemma4 (إلزامي للعب ضد الوزير وتعليقاته)
# احصل على مفتاحك من https://ollama.com ثم أضفه في متغيرات بيئة Railway أيضاً
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
AI_MODEL=gemma4
