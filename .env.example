# انسخ هذا الملف إلى .env وعبّئ القيم

# قاعدة البيانات (Prisma + SQLite) للتطوير و Railway
DATABASE_URL=file:./db/custom.db

# Ollama API - نموذج gemma4 (إلزامي للعب ضد الوزير وتعليقاته)
# احصل على مفتاحك من https://ollama.com
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
AI_MODEL=gemma4

# ===== Cloudflare (يضبطها wrangler.jsonc تلقائياً عند النشر - لا حاجة لتعديلها هنا) =====
# CF_DEPLOY=1
# REALTIME_URL=/rt
